<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.capestone</groupId>
  <artifactId>capestone-selenium-junit-suite</artifactId>
  <version>1.0.0</version>
  <name>capestone-selenium-junit-suite</name>
  <description>Selenium + JUnit 5 end-to-end tests for catalog search/filter/sort/pagination and favorites</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <junit.jupiter.version>5.11.2</junit.jupiter.version>
    <selenium.version>4.23.1</selenium.version>
    <webdrivermanager.version>5.9.2</webdrivermanager.version>
    <restassured.version>5.5.0</restassured.version>
    <assertj.version>3.26.3</assertj.version>
    <slf4j.version>2.0.16</slf4j.version>
    <surefire.version>3.5.2</surefire.version>

    <!-- Override on the command line, e.g. mvn test -Dheadless=true -Dbrowser=firefox -->
    <baseUrl>http://localhost:3000</baseUrl>
    <apiBaseUrl>http://localhost:5000</apiBaseUrl>
    <headless>false</headless>
    <browser>chrome</browser>
    <pageSize>12</pageSize>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.bonigarcia</groupId>
      <artifactId>webdrivermanager</artifactId>
      <version>${webdrivermanager.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${restassured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <systemPropertyVariables>
            <baseUrl>${baseUrl}</baseUrl>
            <apiBaseUrl>${apiBaseUrl}</apiBaseUrl>
            <headless>${headless}</headless>
            <browser>${browser}</browser>
            <pageSize>${pageSize}</pageSize>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
